# Public base URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# mock | telegram
LEAD_DELIVERY_MODE=mock

# Server-only secrets. Never prefix with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional comma-separated request origins.
ALLOWED_ORIGINS=http://localhost:3000
